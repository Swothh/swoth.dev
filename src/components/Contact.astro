---
import SectionLabel from './SectionLabel.astro';
import { portfolio } from '../data/portfolio';
---

<section id="contact" class="section-anchor pt-[116px] pb-[124px] max-[600px]:pt-[88px] max-[600px]:pb-[88px]" aria-labelledby="contact-label">
  <SectionLabel><span id="contact-label">Elsewhere</span></SectionLabel>
  <div class="grid grid-cols-[1fr_1.2fr] gap-14 max-[600px]:grid-cols-1 max-[600px]:gap-[30px]">
    <p class="m-0 text-[1.45rem] leading-[1.35] font-[520] tracking-[-0.035em]">{portfolio.contact.heading[0]}<br />{portfolio.contact.heading[1]}</p>
    <div class="flex flex-col items-start gap-[22px]">
      <div class="flex flex-wrap gap-2">
        {portfolio.links.map((link) => (
          <a class="group rounded-full bg-[var(--surface)] px-3 py-[7px] text-xs text-[var(--muted)] transition-colors duration-200 hover:bg-[var(--surface-hover)] hover:text-[var(--ink)]" href={link.href} target="_blank" rel="noreferrer">
            {link.label}<span class="ml-[5px] inline-block text-[0.625rem] transition-transform duration-200 group-hover:translate-x-px group-hover:-translate-y-px" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <a class="border-b border-[var(--contact-line)] pb-0.5 text-sm transition-colors duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]" href={`mailto:${portfolio.profile.email}`}>{portfolio.profile.email}</a>
    </div>
  </div>
</section>
