---
import SectionLabel from './SectionLabel.astro';
import { formatPostShortDate, getPostHref, getSortedPosts, isExternalPost } from '../lib/posts';

const posts = getSortedPosts();
---

<section id="blog" class="section-anchor pt-[116px] max-[600px]:pt-[88px]" aria-labelledby="blog-label">
  <SectionLabel><span id="blog-label">Writing</span></SectionLabel>
  <div class="border-t border-[var(--line)]">
    {posts.map((post, index) => {
      const href = getPostHref(post);
      const external = isExternalPost(post);

      return (
        <a
          href={href}
          {...(external ? { target: '_blank', rel: 'noreferrer' } : {})}
          class="group grid min-h-[102px] grid-cols-[32px_1fr_auto_18px] items-center gap-3.5 border-b border-[var(--line)] transition-[padding] duration-200 hover:px-2 max-[600px]:min-h-[104px] max-[600px]:grid-cols-[26px_1fr_16px]"
        >
          <span class="text-[0.6875rem] tracking-[0.08em] text-[var(--faint)]">0{index + 1}</span>
          <span class="flex flex-col gap-[3px]">
            <span class="flex items-center gap-3">
              <strong class="text-base font-[650] tracking-[-0.025em]">{post.data.title}</strong>
            </span>
            <small class="text-[0.8125rem] text-[var(--muted)]">{post.data.summary}</small>
          </span>
          <span class="text-[0.6875rem] whitespace-nowrap text-[var(--faint)] tabular-nums max-[600px]:hidden">
            <time datetime={post.data.publishedAt}>{formatPostShortDate(post.data.publishedAt)}</time> · {post.data.readingTime}
          </span>
          <span
            class="text-xs text-[var(--muted)] transition-all duration-200 group-hover:translate-x-px group-hover:-translate-y-px group-hover:text-[var(--accent)]"
            aria-hidden="true"
          >↗</span>
        </a>
      );
    })}
  </div>
</section>
