---
import SectionLabel from './SectionLabel.astro';
import { portfolio } from '../data/portfolio';
import { getProjectHref } from '../lib/projects';
---

<section class="pt-[116px] max-[600px]:pt-[88px]" aria-labelledby="selected-label">
  <SectionLabel><span id="selected-label">Selected work</span></SectionLabel>
  <div class="border-t border-[var(--line)]">
    {portfolio.projects.map((project, index) => {
      const href = getProjectHref(project);
      const Tag = href ? 'a' : 'div';

      return (
        <Tag
          class:list={[
            'group grid min-h-[102px] grid-cols-[32px_1fr_auto_18px] items-center gap-3.5 border-b border-[var(--line)] transition-[padding] duration-200 max-[600px]:min-h-[104px] max-[600px]:grid-cols-[26px_1fr_16px]',
            href && 'hover:px-2'
          ]}
          {...(href ? { href, target: '_blank', rel: 'noreferrer' } : {})}
        >
          <span class="text-[0.6875rem] tracking-[0.08em] text-[var(--faint)]">0{index + 2}</span>
          <span class="flex flex-col gap-[3px]">
            <span class="flex items-center gap-3">
              <strong class="text-base font-[650] tracking-[-0.025em]" style={{ fontFamily: project.font, fontSize: project.size, letterSpacing: project.spacing, fontWeight: project.weight }}>{project.name}</strong>
              {project.repository && (
                <span
                  class="repository-stats items-center gap-2.5 text-[0.6875rem] text-[var(--muted)] tabular-nums"
                  data-repository-stats
                  data-repository={project.repository}
                  aria-live="polite"
                  hidden
                >
                  <span class="flex items-center gap-1" title="GitHub stars">
                    <svg class="h-3 w-3 overflow-visible fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.6]" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m12 2.7 2.83 5.73 6.32.92-4.57 4.46 1.08 6.3L12 17.13l-5.66 2.98 1.08-6.3-4.57-4.46 6.32-.92L12 2.7Z"></path>
                    </svg>
                    <span data-repository-stars></span>
                  </span>
                  <span class="flex items-center gap-1" title="GitHub forks">
                    <svg class="h-3 w-3 overflow-visible fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.6]" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="7" cy="5" r="2.25"></circle>
                      <circle cx="17" cy="5" r="2.25"></circle>
                      <circle cx="12" cy="19" r="2.25"></circle>
                      <path d="M7 7.25v2.2c0 1.5 1.2 2.7 2.7 2.7h4.6c1.5 0 2.7-1.2 2.7-2.7v-2.2M12 12.15v4.6"></path>
                    </svg>
                    <span data-repository-forks></span>
                  </span>
                </span>
              )}
            </span>
            <small class="text-[0.8125rem] text-[var(--muted)]">{project.description}</small>
          </span>
          <span class="text-[0.6875rem] whitespace-nowrap text-[var(--faint)] max-[600px]:hidden">{project.stack.join(' · ')}</span>
          {href ? (
            <span class="text-xs text-[var(--muted)] transition-all duration-200 group-hover:translate-x-px group-hover:-translate-y-px group-hover:text-[var(--accent)]" aria-hidden="true">↗</span>
          ) : (
            <span aria-hidden="true"></span>
          )}
        </Tag>
      );
    })}
  </div>
</section>
